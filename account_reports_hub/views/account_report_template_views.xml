<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_report_template_tree" model="ir.ui.view">
        <field name="name">account.report.template.tree</field>
        <field name="model">account.report.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="report_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_account_report_template_form" model="ir.ui.view">
        <field name="name">account.report.template.form</field>
        <field name="model">account.report.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="report_type"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="base_domain" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_report_template" model="ir.actions.act_window">
        <field name="name">Report Templates</field>
        <field name="res_model">account.report.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_account_report_hub_root"
              name="Custom Accounting Reports"
              parent="account.menu_finance_reports"
              sequence="90"/>

    <menuitem id="menu_account_report_templates"
              name="Report Templates"
              parent="menu_account_report_hub_root"
              action="action_account_report_template"
              sequence="20"/>
</odoo>
