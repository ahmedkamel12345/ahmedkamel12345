<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="financial_statement_report_multi_company_rule" model="ir.rule">
        <field name="name">Financial Statement Report Multi Company</field>
        <field name="model_id" ref="model_financial_statement_report"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="financial_ratio_report_multi_company_rule" model="ir.rule">
        <field name="name">Financial Ratio Report Multi Company</field>
        <field name="model_id" ref="model_financial_ratio_report"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
